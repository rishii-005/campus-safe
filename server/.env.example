# Neon: copy the connection string from the Neon dashboard (it already contains ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Set to false only for a local, non-SSL Postgres
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=8h
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
ENABLE_REGISTRATION=true
# Leave empty to use local disk storage in server/uploads
CLOUDINARY_URL=
